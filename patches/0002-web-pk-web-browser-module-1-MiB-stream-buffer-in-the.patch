--- /dev/null
+++ b/examples/web/CMakeLists.txt
@@ -0,0 +1,24 @@
+# pk-web: browser module (ES6, MODULARIZE) around the C ABI. Emscripten only.
+# ggml-webgpu's INTERFACE link options do not reach this link line (transcribe
+# links ggml PRIVATE), so the emdawnwebgpu port and the async flavour are
+# repeated here. GGML_WEBGPU_JSPI=ON: JSPI + wasm exceptions; OFF: ASYNCIFY.
+add_executable(pk-web pk_web.cpp)
+target_link_libraries(pk-web PRIVATE transcribe)
+set(PK_ASYNC_EXPORTS "pk_load,pk_run,pk_free")
+if(EMDAWNWEBGPU_DIR)
+    target_link_options(pk-web PRIVATE "--use-port=${EMDAWNWEBGPU_DIR}/emdawnwebgpu.port.py")
+else()
+    target_link_options(pk-web PRIVATE "--use-port=emdawnwebgpu")
+endif()
+if(GGML_WEBGPU_JSPI)
+    target_link_options(pk-web PRIVATE "-sJSPI" "-fwasm-exceptions" "-sJSPI_EXPORTS=${PK_ASYNC_EXPORTS}")
+else()
+    target_link_options(pk-web PRIVATE "-sASYNCIFY" "-fexceptions" "-sASYNCIFY_STACK_SIZE=65536" "-sASYNCIFY_EXPORTS=${PK_ASYNC_EXPORTS}")
+endif()
+target_link_options(pk-web PRIVATE
+    "-sMODULARIZE=1" "-sEXPORT_ES6=1" "-sEXPORT_NAME=createPk" "-sENVIRONMENT=web,worker"
+    "-sALLOW_MEMORY_GROWTH=1" "-sINITIAL_MEMORY=64MB" "-sMAXIMUM_MEMORY=4GB" "-sSTACK_SIZE=5MB"
+    "-sEXPORTED_RUNTIME_METHODS=FS,WORKERFS,ccall,cwrap,UTF8ToString,stringToNewUTF8,HEAPF32,HEAPU8,wasmMemory"
+    "-sEXPORTED_FUNCTIONS=_main,_malloc,_free"
+    "-lworkerfs.js"
+)
diff --git a/examples/web/pk_web.cpp b/examples/web/pk_web.cpp
new file mode 100644
index 00000000..2d06245f
--- /dev/null
+++ b/examples/web/pk_web.cpp
@@ -0,0 +1,128 @@
+// pk_web — browser entry points for transcribe.cpp (WASM, ggml WebGPU backend).
+//
+// Not part of the library ABI. A page (or worker) calls these through the
+// Emscripten module; the ones that touch WebGPU suspend (JSPI or ASYNCIFY) and
+// therefore return promises on the JS side: pk_load, pk_run, pk_free.
+//
+//   pk_setenv(k, v)            set a TRANSCRIBE_* / GGML_* knob before pk_load
+//   pk_load(path, n_threads)   0 on success; model read from the Emscripten FS
+//   pk_run(pcm, n)             0 on success; then pk_text() / pk_json()
+//   pk_json()                  {"text","mel_ms","encode_ms","decode_ms","load_ms","n_tokens","backend"}
+//   pk_log()                   library log lines since the last call (errors, backend notes)
+
+#include "transcribe.h"
+
+#include <emscripten/emscripten.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+
+namespace {
+transcribe_session * g_session = nullptr;
+std::string          g_json;
+std::string          g_log;
+int                  g_log_level = 0;  // 0: warnings and errors; 1: everything
+
+void log_cb(transcribe_log_level level, const char * text, void *) {
+    if (text == nullptr || (g_log_level == 0 && (level == TRANSCRIBE_LOG_LEVEL_INFO || level == TRANSCRIBE_LOG_LEVEL_DEBUG))) {
+        return;
+    }
+    g_log += text;
+    if (g_log.empty() || g_log.back() != '\n') {
+        g_log += '\n';
+    }
+}
+
+std::string json_escape(const char * s) {
+    std::string out;
+    for (; s != nullptr && *s != '\0'; ++s) {
+        const unsigned char c = static_cast<unsigned char>(*s);
+        if (c == '"' || c == '\\') {
+            out += '\\';
+            out += static_cast<char>(c);
+        } else if (c < 0x20) {
+            char buf[8];
+            std::snprintf(buf, sizeof buf, "\\u%04x", c);
+            out += buf;
+        } else {
+            out += static_cast<char>(c);
+        }
+    }
+    return out;
+}
+}  // namespace
+
+extern "C" {
+
+EMSCRIPTEN_KEEPALIVE void pk_setenv(const char * k, const char * v) {
+    if (v == nullptr || *v == '\0') {
+        unsetenv(k);
+    } else {
+        setenv(k, v, 1);
+    }
+}
+
+EMSCRIPTEN_KEEPALIVE void pk_set_log_level(int level) {
+    g_log_level = level;
+}
+
+EMSCRIPTEN_KEEPALIVE const char * pk_log(void) {
+    static std::string out;
+    out.swap(g_log);
+    g_log.clear();
+    return out.c_str();
+}
+
+EMSCRIPTEN_KEEPALIVE int pk_load(const char * path, int n_threads) {
+    transcribe_log_set(log_cb, nullptr);
+    if (g_session != nullptr) {
+        transcribe_close(g_session);
+        g_session = nullptr;
+    }
+    transcribe_session_params sp;
+    transcribe_session_params_init(&sp);
+    sp.n_threads = n_threads > 0 ? n_threads : 1;
+    return static_cast<int>(transcribe_open(path, nullptr, &sp, &g_session));
+}
+
+EMSCRIPTEN_KEEPALIVE const char * pk_backend(void) {
+    return g_session != nullptr ? transcribe_model_backend(transcribe_get_model(g_session)) : "";
+}
+
+EMSCRIPTEN_KEEPALIVE int pk_run(const float * pcm, int n_samples) {
+    if (g_session == nullptr) {
+        return -1;
+    }
+    const transcribe_status st = transcribe_run(g_session, pcm, n_samples, nullptr);
+    if (st != TRANSCRIBE_OK) {
+        g_json = std::string("{\"error\":\"") + json_escape(transcribe_status_string(st)) + "\"}";
+        return static_cast<int>(st);
+    }
+    transcribe_timings t;
+    transcribe_timings_init(&t);
+    transcribe_get_timings(g_session, &t);
+    char nums[256];
+    std::snprintf(nums, sizeof nums, "\"mel_ms\":%.3f,\"encode_ms\":%.3f,\"decode_ms\":%.3f,\"load_ms\":%.1f,\"n_tokens\":%d",
+                  t.mel_ms, t.encode_ms, t.decode_ms, t.load_ms, transcribe_n_tokens(g_session));
+    g_json = std::string("{\"text\":\"") + json_escape(transcribe_full_text(g_session)) + "\"," + nums +
+             ",\"backend\":\"" + json_escape(pk_backend()) + "\"}";
+    return 0;
+}
+
+EMSCRIPTEN_KEEPALIVE const char * pk_json(void) {
+    return g_json.c_str();
+}
+
+EMSCRIPTEN_KEEPALIVE void pk_free(void) {
+    if (g_session != nullptr) {
+        transcribe_close(g_session);
+        g_session = nullptr;
+    }
+}
+
+}  // extern "C"
+
+int main() {
+    return 0;
+}
diff --git a/src/transcribe-load-common.cpp b/src/transcribe-load-common.cpp
index 0f17b856..735c3e0a 100644
--- a/src/transcribe-load-common.cpp
+++ b/src/transcribe-load-common.cpp
@@ -448,7 +448,14 @@ transcribe_status stream_tensor_data(const std::string &  path,
     // time: ifstream::seekg takes a streamoff (signed 64-bit on every
     // platform we target), so multi-GB tensor offsets work without
     // #ifdef'ing fseeko vs _fseeki64.
-    std::ifstream fin(path_from_utf8(path), std::ios::binary);
+    // 1 MiB stream buffer: libc++'s filebuf otherwise refills 4 KiB at a
+    // time, and on file systems where every read() is expensive (Emscripten
+    // WORKERFS / OPFS: one synchronous Blob slice per call) a 700 MB model
+    // took ~170 s to load instead of ~2 s.
+    std::vector<char> io_buf(1u << 20);
+    std::ifstream     fin;
+    fin.rdbuf()->pubsetbuf(io_buf.data(), static_cast<std::streamsize>(io_buf.size()));
+    fin.open(path_from_utf8(path), std::ios::binary);
     if (!fin) {
         log_msg(TRANSCRIBE_LOG_LEVEL_ERROR, "%s: failed to reopen %s for tensor data", error_tag, path.c_str());
         return TRANSCRIBE_ERR_GGUF;
@@ -640,7 +647,10 @@ ReadF32Result read_f32_tensor_checked(gguf_context *       gguf_ctx,
     const size_t data_off = gguf_get_data_offset(gguf_ctx);
     const size_t t_off    = gguf_get_tensor_offset(gguf_ctx, idx);
 
-    std::ifstream fin(path_from_utf8(gguf_path), std::ios::binary);
+    std::vector<char> io_buf(std::min<size_t>(nbytes, 1u << 20) + 16);
+    std::ifstream     fin;
+    fin.rdbuf()->pubsetbuf(io_buf.data(), static_cast<std::streamsize>(io_buf.size()));
+    fin.open(path_from_utf8(gguf_path), std::ios::binary);
     if (!fin) {
         log_msg(TRANSCRIBE_LOG_LEVEL_ERROR, "%s: failed to open %s for tensor \"%s\"", error_tag, gguf_path.c_str(),
                 tensor_name);
