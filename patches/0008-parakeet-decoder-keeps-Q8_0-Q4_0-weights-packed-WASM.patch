+    j.gw_w     = ggml_new_tensor_2d(j.w_ctx, out_w_packed ? GGML_TYPE_Q8_0 : GGML_TYPE_F32, joint_h, joint_n);
     j.gw_b     = ggml_new_tensor_1d(j.w_ctx, GGML_TYPE_F32, joint_n);
 
     j.w_buf = ggml_backend_alloc_ctx_tensors(j.w_ctx, j.w_backend);
@@ -169,8 +217,14 @@ bool build_joint_weight(HostJoint & j, const ggml_tensor * src_out_w) {
