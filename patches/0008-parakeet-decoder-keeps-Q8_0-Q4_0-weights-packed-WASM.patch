index 52defc38..8ce1be73 100644
--- a/src/arch/parakeet/decoder.cpp
+++ b/src/arch/parakeet/decoder.cpp
@@ -108,6 +108,53 @@ bool read_tensor_to_f32(const ggml_tensor * t, std::vector<float> & out) {
     return true;
 }
 
+// The decode loop is two mat-vecs per LSTM layer and two in the joint for
+// every emitted token, over weights that as fp32 do not fit a cache (0.6b:
+// 26 MB of LSTM matrices walked once per token), so it is memory bound.
+// When the model stores those matrices as Q8_0 / Q4_0 they can stay packed:
+// the CPU backend then runs its integer dot kernels (activation quantized to
+// Q8_0 per 32 elements, as every quantized ggml CPU model does) over 4-8x
+// less memory. TRANSCRIBE_DECODER_F32=1 restores the fp32 mirrors.
+bool decoder_keeps_quantized(const ggml_tensor * t) {
+    static const bool f32_only = std::getenv("TRANSCRIBE_DECODER_F32") != nullptr;
+    return !f32_only && t != nullptr && (t->type == GGML_TYPE_Q8_0 || t->type == GGML_TYPE_Q4_0);
+}
+
+// Packed bytes of a Q8_0 / Q4_0 tensor as Q8_0 blocks. A Q4_0 block is
+// rewritten losslessly (same scale, the nibbles minus 8 as int8): the values
+// are identical, the Q8_0 dot kernel is the faster one (WASM SIMD: no nibble
+// unpacking), and the copy is still a quarter of the fp32 mirror.
+bool read_tensor_raw(const ggml_tensor * t, std::vector<uint8_t> & out) {
+    const size_t nbytes = ggml_nbytes(t);
+    if (nbytes == 0) {
+        return false;
+    }
+    if (t->type == GGML_TYPE_Q8_0) {
+        out.resize(nbytes);
+        ggml_backend_tensor_get(t, out.data(), 0, nbytes);
+        return true;
+    }
+    if (t->type != GGML_TYPE_Q4_0) {
+        return false;
+    }
+    std::vector<uint8_t> q4(nbytes);
+    ggml_backend_tensor_get(t, q4.data(), 0, nbytes);
+    const size_t q4_block = 2 + 16, q8_block = 2 + 32;
+    const size_t n_blocks = nbytes / q4_block;
+    out.resize(n_blocks * q8_block);
+    for (size_t ib = 0; ib < n_blocks; ++ib) {
+        const uint8_t * src = q4.data() + ib * q4_block;
+        uint8_t *       dst = out.data() + ib * q8_block;
+        dst[0]              = src[0];
+        dst[1]              = src[1];
+        for (int i = 0; i < 16; ++i) {
+            dst[2 + i]      = static_cast<uint8_t>(static_cast<int8_t>((src[2 + i] & 0x0F) - 8));
+            dst[2 + 16 + i] = static_cast<uint8_t>(static_cast<int8_t>((src[2 + i] >> 4) - 8));
+        }
+    }
+    return true;
+}
+
 // Make the joint network's weights resident as fp32 ggml tensors on the
 // model: enc / pred / out projections. Built once at load. out_w is
 // dequantized from the model tensor src_out_w; the rest come from the
@@ -159,9 +206,10 @@ bool build_joint_weight(HostJoint & j, const ggml_tensor * src_out_w) {
 
     j.g_enc_w  = ggml_new_tensor_2d(j.w_ctx, GGML_TYPE_F32, j.d_enc, joint_h);
