+// The last run's words with their times, as JSON:
+//   [{"w":"Hello","s":0.56,"e":0.8,"p":0.97}, ...]
+// s / e are seconds from the start of the PCM given to pk_run. A word starts at
+// the encoder frame its first token was emitted on and ends where the TDT
+// duration of its last token ends, so both sit on the encoder's frame grid
+// (80 ms for these models). A long clip is encoded in windows but decoded in one
+// pass over the stitched frames, so the times run straight through the window
+// joins. p is the lowest joint probability among the word's tokens (omitted when
+// the model reports none). Built on demand: the live page never pays for it.
+EMSCRIPTEN_KEEPALIVE const char * pk_words(void) {
+    g_words = "[";
+    if (g_session != nullptr) {
+        const int n = transcribe_n_words(g_session);
+        g_words.reserve(static_cast<size_t>(n) * 48 + 2);
+        bool first = true;
+        for (int i = 0; i < n; ++i) {
+            transcribe_word w;
+            transcribe_word_init(&w);
+            if (transcribe_get_word(g_session, i, &w) != TRANSCRIBE_OK || w.text == nullptr || *w.text == '\0') {
+                continue;
+            }
+            float p = NAN;
+            for (int k = 0; k < w.n_tokens; ++k) {
+                transcribe_token tk;
+                transcribe_token_init(&tk);
+                if (transcribe_get_token(g_session, w.first_token + k, &tk) == TRANSCRIBE_OK && tk.text != nullptr &&
+                    !std::isnan(tk.p)) {
+                    p = std::isnan(p) ? tk.p : std::min(p, tk.p);
+                }
+            }
+            char nums[96];
+            if (std::isnan(p)) {
+                std::snprintf(nums, sizeof nums, "\",\"s\":%.3f,\"e\":%.3f}", static_cast<double>(w.t0_ms) / 1000.0,
+                              static_cast<double>(w.t1_ms) / 1000.0);
+            } else {
+                std::snprintf(nums, sizeof nums, "\",\"s\":%.3f,\"e\":%.3f,\"p\":%.3f}",
+                              static_cast<double>(w.t0_ms) / 1000.0, static_cast<double>(w.t1_ms) / 1000.0,
+                              static_cast<double>(p));
+            }
+            g_words += first ? "{\"w\":\"" : ",{\"w\":\"";
+            g_words += json_escape(w.text);
+            g_words += nums;
+            first = false;
+        }
+    }
+    g_words += "]";
+    return g_words.c_str();
+}
+
 EMSCRIPTEN_KEEPALIVE void pk_free(void) {
     if (g_session != nullptr) {
         transcribe_close(g_session);
