+// ----- Chunked long-audio encoding (TRANSCRIBE_PARAKEET_CHUNK_S) -----
+//
+// Full-attention checkpoints without a VAD head: attention memory is quadratic
+// in the clip length. With TRANSCRIBE_PARAKEET_CHUNK_S=<seconds> set, a clip
+// longer than chunk + 2 * halo is encoded in windows instead: the mel is
+// computed (and normalized) once over the whole clip, each window is the
+// chunk's mel frames plus TRANSCRIBE_PARAKEET_CHUNK_HALO_S seconds (default 4)
+// of real audio on each side, and only the chunk's own encoder frames are
+// kept. Windows start on a multiple of the subsampling factor, so the kept
+// frames sit on the same grid as the single-shot encoder's. The stitched
+// encoder output is decoded once, so the decoder state runs through the cuts
+// and there is nothing to merge in the text. Encoder (GPU) memory is that of
+// one window whatever the clip length; the host keeps the mel and the
+// encoder output, both linear and small (about 45 kB per second together).
+// Not bit-identical to single-shot: frames near a cut see halo seconds of
+// context instead of the whole clip.
+struct ChunkPlan {
+    int chunk_frames = 0;  // encoder frames kept per window
+    int halo_frames  = 0;  // encoder frames of context on each side
+};
+
+ChunkPlan chunk_plan(const ParakeetModel * pm) {
+    ChunkPlan    cp;
+    const char * e = std::getenv("TRANSCRIBE_PARAKEET_CHUNK_S");
+    if (e == nullptr || *e == '\0') {
+        return cp;
+    }
+    const double chunk_s = std::atof(e);
+    const char * h       = std::getenv("TRANSCRIBE_PARAKEET_CHUNK_HALO_S");
+    const double halo_s  = (h != nullptr && *h != '\0') ? std::atof(h) : 4.0;
+    const int    sub     = pm->hparams.enc_subsampling_factor > 0 ? pm->hparams.enc_subsampling_factor : 8;
+    const double fps     = 100.0 / static_cast<double>(sub);  // 10 ms mel hop
+    if (chunk_s <= 0.0 || halo_s < 0.0) {
+        return cp;
+    }
+    cp.chunk_frames = std::max(1, static_cast<int>(std::lround(chunk_s * fps)));
+    cp.halo_frames  = static_cast<int>(std::lround(halo_s * fps));
+    return cp;
+}
+
+bool needs_chunked(const ParakeetModel * pm, int n_samples) {
+    const ParakeetHParams & hp = pm->hparams;
+    if (hp.has_vad_head || hp.has_prompt || hp.kestrel_length_masking ||
+        hp.enc_att_context_style != ParakeetHParams::AttContextStyle::Regular || hp.enc_att_context_left >= 0 ||
+        transcribe::debug::enabled()) {
+        return false;
+    }
+    const ChunkPlan cp = chunk_plan(pm);
+    if (cp.chunk_frames <= 0) {
+        return false;
+    }
+    const int     sub     = hp.enc_subsampling_factor > 0 ? hp.enc_subsampling_factor : 8;
+    const int64_t one_win = static_cast<int64_t>(cp.chunk_frames + 2 * cp.halo_frames) * sub * 160;
+    // TRANSCRIBE_PARAKEET_CHUNK_MIN_S: clips up to this long stay single-shot even if longer than one window.
+    const char *  mn      = std::getenv("TRANSCRIBE_PARAKEET_CHUNK_MIN_S");
+    const int64_t min_smp = (mn != nullptr && *mn != '\0') ? static_cast<int64_t>(std::atof(mn) * 16000.0) : 0;
+    return static_cast<int64_t>(n_samples) > std::max(one_win, min_smp);
+}
+
+transcribe_status run_chunked(ParakeetSession *             pc,
+                              ParakeetModel *               pm,
+                              const float *                 pcm,
+                              int                           n_samples,
+                              const transcribe_run_params * params) {
+    if (!pm->mel.has_value()) {
+        return TRANSCRIBE_ERR_INVALID_ARG;
+    }
+    const int64_t      t_mel_start = ggml_time_us();
+    std::vector<float> mel;
+    int                n_mels = 0, n_frames = 0;
+    if (const transcribe_status mst = pm->mel->compute(pcm, static_cast<size_t>(n_samples), mel, n_mels, n_frames);
+        mst != TRANSCRIBE_OK) {
+        return mst;
+    }
+    const int64_t t_mel_us = ggml_time_us() - t_mel_start;
+
+    const int       sub     = pm->hparams.enc_subsampling_factor > 0 ? pm->hparams.enc_subsampling_factor : 8;
+    const int       T_total = pre_encode_time_out(pre_encode_time_out(pre_encode_time_out(n_frames, false), false), false);
+    const ChunkPlan cp      = chunk_plan(pm);
+    // Even windows: no short tail.
+    const int n_chunks = std::max(1, (T_total + cp.chunk_frames - 1) / cp.chunk_frames);
+    const int C        = (T_total + n_chunks - 1) / n_chunks;
+    const int H        = cp.halo_frames;
+
+    std::vector<float> acc;       // kept rows, [T_total, d]
+    std::vector<float> slice;     // one window's mel, row-major [n_mels, frames]
+    int                d        = 0;
+    int                d_enc    = 0;
+    bool               use_proj = false;
+    int64_t            t_enc    = 0;
+    int                max_win  = 0;
+    for (int k = 0; k < n_chunks; ++k) {
+        if (pc->poll_abort()) {
+            return TRANSCRIBE_ERR_ABORTED;
+        }
+        const int c0 = k * C;
+        const int c1 = std::min(T_total, c0 + C);
+        const int a  = std::max(0, c0 - H);
+        const int m0 = a * sub;
+        const int m1 = (c1 + H >= T_total) ? n_frames : std::min(n_frames, (c1 + H) * sub);
+        const int nf = m1 - m0;
+        slice.resize(static_cast<size_t>(n_mels) * static_cast<size_t>(nf));
+        for (int m = 0; m < n_mels; ++m) {
+            std::memcpy(slice.data() + static_cast<size_t>(m) * nf,
+                        mel.data() + static_cast<size_t>(m) * n_frames + m0, static_cast<size_t>(nf) * sizeof(float));
+        }
+        pc->chunk_mel        = slice.data();
+        pc->chunk_mel_frames = nf;
+        pc->chunk_mel_n_mels = n_mels;
+        const int64_t           t0 = ggml_time_us();
+        const transcribe_status st = run_one_shot_inner(pc, pm, pcm, n_samples, params, nullptr);
+        pc->chunk_mel        = nullptr;
+        pc->chunk_mel_frames = 0;
+        if (st != TRANSCRIBE_OK) {
+            return st;
+        }
+        t_enc += ggml_time_us() - t0;  // graph build, compute and the read-back
+        const int T_win = static_cast<int>(pc->encoder_out->ne[1]);
+        max_win         = std::max(max_win, T_win);
+        if (k == 0) {
+            d_enc    = static_cast<int>(pc->encoder_out->ne[0]);
+            use_proj = pc->enc_proj_rows == T_win;
+            d        = use_proj ? static_cast<int>(pc->enc_proj_host.size() / static_cast<size_t>(T_win)) : d_enc;
+            acc.resize(static_cast<size_t>(T_total) * static_cast<size_t>(d));
+        }
+        if ((pc->enc_proj_rows == T_win) != use_proj || T_win < c1 - a) {
+            log_msg(TRANSCRIBE_LOG_LEVEL_ERROR, "parakeet chunked: window %d has %d frames, need %d", k, T_win, c1 - a);
+            return TRANSCRIBE_ERR_BACKEND;
+        }
+        const std::vector<float> & src = use_proj ? pc->enc_proj_host : pc->enc_host;
+        std::memcpy(acc.data() + static_cast<size_t>(c0) * d, src.data() + static_cast<size_t>(c0 - a) * d,
+                    static_cast<size_t>(c1 - c0) * static_cast<size_t>(d) * sizeof(float));
+    }
+    log_msg(TRANSCRIBE_LOG_LEVEL_DEBUG,
+            "parakeet chunked: %d encoder frames in %d windows of %d + 2 x %d halo (largest window %d frames)", T_total,
+            n_chunks, C, H, max_win);
+
+    pc->encoder_out = nullptr;  // the last window's tensor is not the clip's encoder output
+    pc->enc_host.resize(static_cast<size_t>(d_enc) * static_cast<size_t>(T_total));
+    if (use_proj) {
+        pc->enc_proj_host.swap(acc);
+        pc->enc_proj_rows = T_total;
+    } else {
+        pc->enc_host.swap(acc);
+        pc->enc_proj_rows = 0;
+    }
+    const transcribe_status st = decode_and_populate(pc, pm, params, pc->enc_host.data(), T_total, d_enc, -1, nullptr);
+    pc->t_mel_us    = t_mel_us;
+    pc->t_encode_us = t_enc;
+    return st;
+}
+
 bool needs_longform(const ParakeetModel * pm, int n_samples) {
     return pm->hparams.has_vad_head && !longform::fits_one_segment(n_samples, longform_params(pm->hparams));
 }
@@ -1816,6 +1983,10 @@ transcribe_status run(transcribe_session *          session,
         return run_longform(pc, pm, pcm, n_samples, params);
     }
 
+    if (needs_chunked(pm, n_samples)) {
+        return run_chunked(pc, pm, pcm, n_samples, params);
+    }
+
     return run_one_shot_inner(pc, pm, pcm, n_samples, params);
 }
 
