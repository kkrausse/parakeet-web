+// device lost). In a browser these must reach the page instead of aborting the
+// module, so they are logged, counted and kept for ggml_backend_webgpu_last_error().
+static std::string g_webgpu_errors;
+static int         g_webgpu_error_count = 0;
+
+static void ggml_webgpu_record_error(const std::string & msg) {
+    g_webgpu_error_count++;
+    if (g_webgpu_errors.size() < 6000) {
+        g_webgpu_errors += msg;
+        g_webgpu_errors += '\n';
+    }
+    GGML_LOG_ERROR("ggml_webgpu: %s\n", msg.c_str());
+}
+
+webgpu_pipeline ggml_webgpu_create_checked_pipeline(wgpu::Device &                           device,
+                                                    const char *                             shader_code,
+                                                    const char *                             label,
+                                                    const std::vector<wgpu::ConstantEntry> & constants) {
+    // GGML_WEBGPU_BREAK_SHADER=<label substring>: make that shader invalid, to
+    // check that a compiler rejection is reported the way a real one would be.
+    std::string  broken;
+    const char * break_env = std::getenv("GGML_WEBGPU_BREAK_SHADER");
+    if (break_env != nullptr && std::strstr(label, break_env) != nullptr) {
+        broken      = std::string(shader_code) + "\nfn pk_broken() -> f32 { return undefined_symbol_for_testing; }\n";
+        shader_code = broken.c_str();
+    }
+
     wgpu::ShaderSourceWGSL shader_source;
     shader_source.code = shader_code;
 
     wgpu::ShaderModuleDescriptor shader_desc;
     shader_desc.nextInChain = &shader_source;
 
+    // GGML_WEBGPU_DUMP_SHADERS=<dir>: write every WGSL source that reaches the
+    // device (after preprocessing), to run them through other WGSL compilers.
+    if (const char * dump_dir = std::getenv("GGML_WEBGPU_DUMP_SHADERS")) {
+        static int  n_dumped = 0;
+        std::string path     = std::string(dump_dir) + "/" + std::to_string(n_dumped++) + "_" + label + ".wgsl";
+        if (FILE * f = std::fopen(path.c_str(), "w")) {
+            for (const auto & c : constants) {
+                std::fprintf(f, "// override %s = %.0f\n", std::string(c.key).c_str(), c.value);
+            }
+            std::fputs(shader_code, f);
+            std::fclose(f);
+        }
+    }
+
+    // A shader another WGSL compiler rejects must be named, with the compiler's
+    // message and line: the error scope catches the failure without blocking
+    // (the callbacks run on a later wait), instead of an anonymous uncaptured error.
+    device.PushErrorScope(wgpu::ErrorFilter::Validation);
     wgpu::ShaderModule shader_module = device.CreateShaderModule(&shader_desc);
 
     wgpu::ComputePipelineDescriptor pipeline_desc;
@@ -362,7 +413,38 @@ static webgpu_pipeline ggml_webgpu_create_pipeline(wgpu::Device &
         pipeline_desc.compute.constants     = constants.data();
         pipeline_desc.compute.constantCount = constants.size();
     }
-    return { device.CreateComputePipeline(&pipeline_desc), label };
+    wgpu::ComputePipeline pipeline = device.CreateComputePipeline(&pipeline_desc);
+    std::string           name     = label;
+    device.PopErrorScope(wgpu::CallbackMode::AllowSpontaneous,
+                         [name, shader_module](wgpu::PopErrorScopeStatus status, wgpu::ErrorType type,
+                                               wgpu::StringView message) {
+                             if (status != wgpu::PopErrorScopeStatus::Success || type == wgpu::ErrorType::NoError) {
+                                 return;
+                             }
+                             ggml_webgpu_record_error("shader/pipeline '" + name + "' failed: " + std::string(message));
+                             shader_module.GetCompilationInfo(
+                                 wgpu::CallbackMode::AllowSpontaneous,
+                                 [name](wgpu::CompilationInfoRequestStatus st, const wgpu::CompilationInfo * info) {
+                                     if (st != wgpu::CompilationInfoRequestStatus::Success || info == nullptr) {
+                                         return;
+                                     }
+                                     for (size_t i = 0; i < info->messageCount && i < 4; i++) {
+                                         const wgpu::CompilationMessage & m = info->messages[i];
+                                         ggml_webgpu_record_error("  WGSL '" + name + "' line " +
+                                                                  std::to_string(m.lineNum) + ":" +
+                                                                  std::to_string(m.linePos) + ": " +
+                                                                  std::string(m.message));
+                                     }
+                                 });
+                         });
+    return { pipeline, label };
+}
+
+static webgpu_pipeline ggml_webgpu_create_pipeline(wgpu::Device &                           device,
+                                                   const char *                             shader_code,
+                                                   const char *                             label,
+                                                   const std::vector<wgpu::ConstantEntry> & constants = {}) {
