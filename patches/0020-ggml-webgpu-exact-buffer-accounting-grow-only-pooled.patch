+// GPU objects this backend holds and has made, as JSON. Sizes are bytes asked
+// of the device, not what the driver reserved. "live" changes only when a
+// buffer is created or destroyed; every other number only grows.
+extern "C" const char * ggml_backend_webgpu_stats_json(void) {
+    static std::string          out;
+    std::lock_guard<std::mutex> lock(g_webgpu_stats.mutex);
+    struct agg {
+        uint64_t bytes = 0, count = 0;
+    };
+    agg                               weights, compute, idle, staging, params, other, tensor_other;
+    uint64_t                          live_bytes = 0;
+    std::unordered_map<int, uint64_t> by_type;
+    for (const auto & kv : g_webgpu_stats.live) {
+        const webgpu_buf_record & r = kv.second;
+        agg *                     a = &other;
+        switch (r.kind) {
+            case WEBGPU_BUF_TENSOR:
+                a = r.owner == nullptr ? &tensor_other :
+                    r.owner->usage == GGML_BACKEND_BUFFER_USAGE_WEIGHTS ? &weights :
+                    r.owner->usage == GGML_BACKEND_BUFFER_USAGE_COMPUTE ? &compute : &tensor_other;
+                break;
+            case WEBGPU_BUF_POOL_IDLE:
+                a = &idle;
+                break;
+            case WEBGPU_BUF_STAGING:
+                a = &staging;
+                break;
+            case WEBGPU_BUF_PARAMS:
+                a = &params;
+                break;
+            default:
+                break;
+        }
+        a->bytes += r.size;
+        a->count++;
+        live_bytes += r.size;
+        for (const auto & w : r.weight_bytes) {
+            by_type[w.first] += w.second;
+        }
+    }
+    auto num = [](uint64_t v) { return std::to_string((unsigned long long) v); };
+    auto obj = [&](const char * name, const agg & a) {
+        return std::string("\"") + name + "\":{\"bytes\":" + num(a.bytes) + ",\"count\":" + num(a.count) + "}";
+    };
+    out = "{\"live_bytes\":" + num(live_bytes) + ",\"live_count\":" + num(g_webgpu_stats.live.size()) + "," +
+          obj("weights", weights) + "," + obj("compute", compute) + "," + obj("compute_idle", idle) + "," +
+          obj("staging", staging) + "," + obj("params", params) + "," + obj("tensor_other", tensor_other) + "," +
+          obj("other", other) + ",\"weights_by_type\":{";
+    bool first = true;
+    for (const auto & w : by_type) {
+        out += std::string(first ? "" : ",") + "\"" + ggml_type_name((ggml_type) w.first) + "\":" + num(w.second);
+        first = false;
+    }
+    out += "},\"buffers_created\":" + num(g_webgpu_stats.buffers_created) +
+           ",\"bytes_created\":" + num(g_webgpu_stats.bytes_created) +
+           ",\"buffers_destroyed\":" + num(g_webgpu_stats.buffers_destroyed) +
+           ",\"bytes_destroyed\":" + num(g_webgpu_stats.bytes_destroyed) +
+           ",\"pool_hits\":" + num(g_webgpu_stats.pool_hits) + ",\"pool_misses\":" + num(g_webgpu_stats.pool_misses) +
+           ",\"pipelines\":" + num(g_webgpu_stats.pipelines) + ",\"shader_modules\":" + num(g_webgpu_stats.shader_modules) +
+           ",\"bind_group_layouts\":" + num(g_webgpu_stats.bind_group_layouts) +
+           ",\"bind_groups\":" + num(g_webgpu_stats.bind_groups) +
+           ",\"command_encoders\":" + num(g_webgpu_stats.command_encoders) +
+           ",\"submits\":" + num(g_webgpu_stats.submits) + ",\"write_buffers\":" + num(g_webgpu_stats.write_buffers) +
+           ",\"write_bytes\":" + num(g_webgpu_stats.write_bytes) + ",\"maps\":" + num(g_webgpu_stats.maps) + "}";
+    return out.c_str();
+}
