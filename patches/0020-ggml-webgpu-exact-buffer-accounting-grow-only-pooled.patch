 /* GGML Backend Buffer Interface */
 
+// Compute buffers are pooled. transcribe.cpp frees its graph allocator after
+// every run and allocates again milliseconds later, and in a live transcription
+// every run has a different length. A buffer that is destroyed and replaced
+// costs more than its creation: Dawn releases destroyed memory only after a
+// later submit has completed, and WebKit keeps the Metal buffer of a destroyed
+// GPUBuffer alive for as long as any bind group made with it exists, which in a
+// browser is until the JS garbage collector finds those bind groups. So a freed
+// compute buffer is kept, an allocation takes the smallest kept buffer that is
+// large enough however much larger it is, and a new buffer is made in a size
+// class (ggml_webgpu_pool_class) so that growing lengths settle on one buffer
+// instead of making one per length. At steady state a run creates no buffer.
+// GGML_WEBGPU_BUFFER_CACHE=0 turns the pool off (destroy on free, exact sizes);
+// ggml_backend_webgpu_trim() destroys the idle buffers.
+static bool ggml_webgpu_pool_on() {
+    static const bool on = std::getenv("GGML_WEBGPU_BUFFER_CACHE") == nullptr ||
+                           std::getenv("GGML_WEBGPU_BUFFER_CACHE")[0] != '0';
+    return on;
+}
+
+// GGML_WEBGPU_POOL=legacy: the earlier policy, for comparison (a kept buffer is
+// reused only if it is at most twice the size asked for plus 16 MiB, otherwise
+// everything kept is destroyed and a buffer of the exact size is made).
+static bool ggml_webgpu_pool_legacy() {
+    static const bool legacy = std::getenv("GGML_WEBGPU_POOL") != nullptr &&
+                               std::strcmp(std::getenv("GGML_WEBGPU_POOL"), "legacy") == 0;
+    return legacy;
+}
+
+#define WEBGPU_POOL_MAX_IDLE 8
+
+// Size classes: 4 MiB steps up to 16 MiB, then a quarter of the power of two
+// below (at most 25% above what was asked for), never above max_size.
+static size_t ggml_webgpu_pool_class(size_t want, size_t max_size) {
+    size_t step = 4u << 20;
+    while (step * 8 <= want) {
+        step *= 2;
+    }
+    size_t cls = (want + step - 1) / step * step;
+    if (cls > max_size) {
