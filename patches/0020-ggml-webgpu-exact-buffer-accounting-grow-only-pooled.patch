+// destroy() frees the GPU memory now. Dropping the last reference does not: in a
+// browser the allocation then lives until the JS garbage collector finds the
+// GPUBuffer, and the collector does not see the GPU memory behind it.
+static void ggml_webgpu_destroy_buffer(wgpu::Buffer & buffer) {
+    if (!buffer) {
+        return;
+    }
+    {
+        std::lock_guard<std::mutex> lock(g_webgpu_stats.mutex);
+        auto                        it = g_webgpu_stats.live.find(buffer.Get());
+        if (it != g_webgpu_stats.live.end()) {
+            g_webgpu_stats.buffers_destroyed++;
+            g_webgpu_stats.bytes_destroyed += it->second.size;
+            g_webgpu_stats.live.erase(it);
+        }
+    }
+    buffer.Destroy();
+    buffer = nullptr;
+}
+
+static void ggml_webgpu_stats_set_kind(const wgpu::Buffer & buffer, webgpu_buf_kind kind, ggml_backend_buffer_t owner) {
+    std::lock_guard<std::mutex> lock(g_webgpu_stats.mutex);
+    auto                        it = g_webgpu_stats.live.find(buffer.Get());
+    if (it != g_webgpu_stats.live.end()) {
+        it->second.kind  = kind;
+        it->second.owner = owner;
+    }
+}
+
+static void ggml_webgpu_stats_weight_write(ggml_backend_buffer_t buffer, const wgpu::Buffer & buf, const ggml_tensor * tensor, size_t size) {
+    if (buffer == nullptr || buffer->usage != GGML_BACKEND_BUFFER_USAGE_WEIGHTS) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(g_webgpu_stats.mutex);
+    auto                        it = g_webgpu_stats.live.find(buf.Get());
+    if (it != g_webgpu_stats.live.end()) {
+        it->second.weight_bytes[(int) tensor->type] += size;
+    }
+}
 
